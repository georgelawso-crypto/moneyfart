# --- Betfair (https://developer.betfair.com) ---
# AU (default): betfair.com.au accounts. Logs in at identitysso.betfair.com.au (Betfair Australia's
# endpoints; the .com ones are a common cause of 403 errors for Australian accounts), paper account
# in AUD, times in Sydney time. COM: international/UK accounts (.com endpoints, GBP, London time).
BETFAIR_JURISDICTION=AU
BETFAIR_APP_KEY=
BETFAIR_USERNAME=
BETFAIR_PASSWORD=
# Alternatively an existing session token instead of username/password:
# BETFAIR_SESSION_TOKEN=
# Non-interactive (certificate) login, recommended by Betfair for bots:
# BETFAIR_CERT_FILE=/path/to/client-2048.crt
# BETFAIR_KEY_FILE=/path/to/client-2048.key
# Endpoint overrides (normally set by BETFAIR_JURISDICTION; https only), e.g. Italy:
# BETFAIR_API_URL=https://api.betfair.it/exchange
# BETFAIR_IDENTITY_URL=https://identitysso.betfair.it/api
# BETFAIR_CERT_IDENTITY_URL=https://identitysso-cert.betfair.it/api
# BETFAIR_KEEPALIVE_MINUTES=240

# --- Trading ---
# paper (default): simulated against the live order book. live: REAL MONEY.
TRADING_MODE=paper
PAPER_STARTING_BALANCE=1000
PAPER_COMMISSION_RATE=0.05
# PAPER_CURRENCY=AUD          # default follows BETFAIR_JURISDICTION (AUD for AU, GBP for COM)
# MIN_BET_SIZE=5
# MIN_BET_PAYOUT=30

# --- Risk limits (account currency) ---
# Enforced on every bet, in paper and live mode, underneath every strategy and bot. Bets that
# close positions always go through; everything else must fit all five.
# TRADING_MODE=live refuses to start until all five are filled in with numbers you chose
# (paper mode uses 25 / 250 / 250 / 500 / 250 while they are empty).
#
# Largest back stake of one bet:
MAX_STAKE=
# Largest liability of one bet (a back's stake, or a lay's stake x (price - 1)):
MAX_LIABILITY=
# Largest worst-case loss on one market, unmatched bets counted as if they matched:
MAX_MARKET_LIABILITY=
# Largest worst-case loss across everything open:
MAX_TOTAL_EXPOSURE=
# The most the connector can lose in a day: today's settled losses plus the worst case of
# everything still open never go above it. Days start at midnight in DISPLAY_TIMEZONE.
DAILY_LOSS_LIMIT=
#
# Kill switch: the kill_switch tool (or Claude, if it sees something wrong) can stop everything.
# Only you can release it: delete DATA_DIR/kill-switch.json (or restart, without DATA_DIR).

# --- Recording and bots ---
RECORD_INTERVAL_SECONDS=30
BOT_INTERVAL_SECONDS=5
MAX_MONITORED_MARKETS=20

# --- Output ---
# snake (BFExplorer's current names), legacy (PascalCase names used by most prompts) or both
TOOL_NAMES=snake
# DISPLAY_TIMEZONE=Australia/Sydney   # default follows BETFAIR_JURISDICTION
# BFEXPLORER_STRICT=1

# --- Persistence (paper ledger, AI contexts, settings, bots, settled results, kill switch) ---
# DATA_DIR=./data

# --- HTTP transport ---
# Required for HTTP (generate with: openssl rand -hex 32). stdio needs no token.
MCP_AUTH_TOKEN=
HOST=127.0.0.1
PORT=3000
# MCP_ALLOWED_ORIGINS=https://example.com
# MCP_MAX_SESSIONS=100
# MCP_ALLOW_UNAUTHENTICATED_LOOPBACK=1   # local paper-mode server only
# BFEXPLORER_COMPAT=1                    # serve MCP at / on port 10043 for existing BFExplorer clients
