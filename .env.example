# --- Betfair (https://developer.betfair.com) ---
BETFAIR_APP_KEY=
BETFAIR_USERNAME=
BETFAIR_PASSWORD=
# Alternatively supply an existing session token instead of username/password:
# BETFAIR_SESSION_TOKEN=
# Optional non-interactive (certificate) login, recommended by Betfair for bots:
# BETFAIR_CERT_FILE=/path/to/client-2048.crt
# BETFAIR_KEY_FILE=/path/to/client-2048.key
# Other jurisdictions, e.g. Italy/Spain: https://api.betfair.it/exchange, https://identitysso.betfair.it/api
# BETFAIR_API_URL=https://api.betfair.com/exchange
# BETFAIR_IDENTITY_URL=https://identitysso.betfair.com/api

# --- Trading ---
# paper (default): simulated against the live order book. live: REAL MONEY.
TRADING_MODE=paper
MAX_STAKE=25
MAX_LIABILITY=250
PAPER_STARTING_BALANCE=1000
PAPER_COMMISSION_RATE=0.05

# --- Recording of monitored markets (price history / candlesticks) ---
RECORD_INTERVAL_SECONDS=30
MAX_MONITORED_MARKETS=20

# --- Persistence (paper ledger, AI data contexts, custom strategies) ---
# DATA_DIR=./data

# --- HTTP transport (remote connector) ---
# Required whenever HOST is not a loopback address. Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=
HOST=127.0.0.1
PORT=3000
